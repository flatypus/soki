  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next build && next export",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:purge": "docker compose down -v",
    "db:push": "envx run bunx drizzle-kit push",
